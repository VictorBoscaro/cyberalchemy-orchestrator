__pycache__/
*.pyc
*.log
.server.*
node_modules/

# Local DomainSpec framework mount and remaining shared skill junctions.
# The generic spec skill is vendored locally; the entries below stay owned by ~/domainspec.
/domainspec
/.claude/skills/domainspec-emit-signals
/.claude/skills/domainspec-feature-glossary
/.claude/skill-link-backups/

# Local host-discovery mirror of .claude/{skills,agents} for Codex and other
# hosts. Generated locally (copy or symlink); .claude/ stays the only source.
/.agents/

# Locally scaffolded web mounts. Each entry under sites/ is its own git
# repository with its own history and remote; this repo does not vendor them.
/sites/

# Append-only dispatch ledger — managed locally via the official appender
# (register-dispatch / append-dispatch.cjs), not through ordinary git edits.
/telemetry/agents/subagents-dispatch.yaml

# Assay S0 generated audit output (reproducible by running assay_s0.py).
/internal-tools/document-information-estimator/s0/out/

# Scratch dispatch proposals written next to the repo root by review runs.
*.tmp.json
/.dispatch-proposal.json
/.dispatch-proposal.canonical.json
/.dispatch-concrete-proposal.md

# Confirmation markers written next to a pending dispatch sheet at runtime.
# They record when a sheet was confirmed on this machine; the sheet itself is
# the tracked artifact.
/telemetry/agents/pending/*.confirmed

# Scratch working directory: PDF page rasters and one-off probe scripts written
# by render and inspection runs. Regenerable from the tracked sources.
/tmp/

# Short-edition page rasters and contact sheets kept next to their sources for
# review. Same rule as /tmp/: re-render them from the tracked HTML and PDF.
/plans/governed-agent-work-infrastructure/essays/work-context-system-view/pdf-version/short-version/**/*.png

# Verification-render directories inside dispatch folders under plans/**
# (draft/final crops, PDF page rasters, audit renders). Reproducible from the
# tracked SVGs and already hash-attested in the journal; scoped to dispatch
# folders only, not a blanket plans/-wide PNG rule.
plans/**/*-dispatch/validation/
plans/**/*-dispatch/pdf-renders/
plans/**/*-dispatch/audit-renders/

# Runtime SQLite databases — regenerable runtime state, not source.
/telemetry/runtime/

# FOODSToGo JBP render output — reproduced deterministically by render.sh.
/experiments/foodstogo-jbp-2025/out/

# Playwright / ux-evidence-validator run artifacts (traces, screenshots,
# measurements). Regenerable by re-running the suite that wrote them.
/output/

# Arcanum install surfaces. Runtime adapter config is per-machine — regenerate
# it with `tools/arcanum` (which writes the default config), or re-run the
# upstream bootstrap from an Arcanum checkout. Observability holds run evidence.
/.arcanum/runtime/
/.arcanum/observability/envelopes/*
/.arcanum/observability/runs/*
/.arcanum/observability/reflections/*
/.arcanum/observability/by-sigil/*.jsonl
/.arcanum/observability/by-capability/**/*.jsonl
/.arcanum/observability/hooks/*.jsonl
/.arcanum/observability/signals/*.jsonl
/.arcanum/observability/reflection-state.json
!/.arcanum/observability/runs/.gitkeep
!/.arcanum/observability/reflections/.gitkeep
!/.arcanum/observability/signals/.gitkeep
!/.arcanum/observability/hooks/reflections/.gitkeep
