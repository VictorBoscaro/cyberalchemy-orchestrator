{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/rwo/schemas/work-graph/1.0.0",
  "title": "RWO WorkGraph 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "profile_id", "profile_version", "schema_id", "schema_version", "composition_id", "nodes", "edges"],
  "properties": {
    "contract_id": {"const": "RWO-SEMANTIC-CONTRACT"},
    "contract_version": {"const": "1.0.0"},
    "profile_id": {"const": "RWO-JCS-IJSON-SAFEINT"},
    "profile_version": {"const": "1.0.0"},
    "schema_id": {"const": "WorkGraph"},
    "schema_version": {"const": "1.0.0"},
    "composition_id": {"$ref": "#/$defs/identifier"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version"],
      "properties": {
        "schema_id": {"$ref": "#/$defs/identifier"},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "node_type": {"$ref": "#/$defs/identifier"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "source_node_id", "target_node_id", "event_type", "event_payload_schema", "command_type", "command_payload_schema", "payload_derivation"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/identifier"},
        "source_node_id": {"$ref": "#/$defs/identifier"},
        "target_node_id": {"$ref": "#/$defs/identifier"},
        "event_type": {"$ref": "#/$defs/identifier"},
        "event_payload_schema": {"$ref": "#/$defs/schemaRef"},
        "command_type": {"$ref": "#/$defs/identifier"},
        "command_payload_schema": {"$ref": "#/$defs/schemaRef"},
        "payload_derivation": {"const": "copy-event-payload"}
      }
    }
  },
  "x-rwo-normalization": {
    "nodes": {"elementType": "WorkNode/1.0.0", "primaryKeyPaths": ["node_id"], "duplicatePolicy": "reject"},
    "edges": {"elementType": "WorkEdge/1.0.0", "primaryKeyPaths": ["edge_id"], "duplicatePolicy": "reject"}
  },
  "x-rwo-derived-fields-excluded": ["graph_identity"]
}
