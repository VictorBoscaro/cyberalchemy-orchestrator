{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rwo.ontology.relation@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "predicate",
    "relation_kind",
    "source_node",
    "target_node",
    "direction",
    "owner_route",
    "evidence_refs",
    "authority_effect",
    "cycle_policy",
    "runtime_posture",
    "properties",
    "description",
    "forbidden_inferences"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "pattern": "^rwo:relation:[a-z0-9.-]+$"
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "relation_kind": {
      "enum": [
        "structural",
        "evidence",
        "finding",
        "contradiction",
        "integration",
        "governance",
        "validation",
        "prohibition"
      ]
    },
    "source_node": {
      "type": "string",
      "pattern": "^rwo:[A-Za-z0-9._:-]+$"
    },
    "target_node": {
      "type": "string",
      "pattern": "^rwo:[A-Za-z0-9._:-]+$"
    },
    "direction": {
      "const": "directed"
    },
    "owner_route": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rwo:source:[a-z0-9-]+$"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "cycle_policy": {
      "enum": ["acyclic", "bounded-only", "temporal", "not-applicable"]
    },
    "runtime_posture": {
      "enum": [
        "freshly-executed",
        "observed",
        "execution-unverified",
        "designed",
        "absent",
        "blocked",
        "deferred",
        "not-applicable"
      ]
    },
    "properties": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_inferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
