  "test_matrix": {
    "T-ACI-POL2-1": "independently compare exact closed receipt, canonical preimage, ordered reasons, denial digest and receipt digest with the checked-in oracle",
    "T-ACI-POL2-2": "reject missing, partial, reordered, tampered or noncanonical L1 evidence, every positive ceiling or grant and authority-domain substitution before the denial transaction with zero rows",
    "T-ACI-POL2-3": "accept exactly twelve unique scalar selectors and collapse all to one receipt while rejecting wrong type, collections, duplicates, missing, empty, unknown or decision/reason drift",
    "T-ACI-POL2-4": "roll back all three pre-commit failpoints, preserve one row after post-commit lost response and keep foreign_key_check empty",
    "T-ACI-POL2-5": "converge unchanged key or lineage replay and reject cross-bound axes or controlled evidence drift without mutation or caller-controlled projection fields",
    "T-ACI-POL2-6": "fresh database, L1 and L2 handles reproduce source binding, receipt bytes and both digests; in-memory SQLite rejects",
    "T-ACI-POL2-7": "exercise all labels independently with zero workload-filesystem, network, process, credential, tool, provider, runtime, journal, audit, clock or environment calls",
    "T-ACI-POL2-8": "preserve exact L1 cardinalities and bytes, add only one L2 table and row, keep all production authority/runtime/effect rows and L3 evidence empty and reject synthetic inputs at production seams"
  },
