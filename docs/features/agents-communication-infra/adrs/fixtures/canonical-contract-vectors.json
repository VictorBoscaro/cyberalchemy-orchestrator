  "canonicalization": {
    "character_encoding": "UTF-8 without BOM",
    "unicode": "Normalize every string value and object key to NFC before duplicate-key detection and ordering.",
    "objects": "Reject duplicate keys after NFC normalization; order keys by Unicode scalar value; emit no insignificant whitespace.",
    "arrays": "Preserve array order and recursively canonicalize every member.",
    "omitted_and_null": "A missing optional field is omitted. An explicitly supplied nullable field is retained as null. They are not digest-equivalent.",
    "integers": "Only signed 64-bit integers are admitted; emit base-10 JSON integers with no leading plus or leading zero and normalize negative zero to zero.",
    "decimals": "Decimal contract fields are supplied as strings, never JSON binary floats. Parse exactly, reject NaN/Infinity/exponent output, remove a leading plus and redundant leading/trailing zeros, and emit a plain decimal string; normalize every zero to '0'. A schema that requires fixed scale must define that scale in its versioned projection.",
    "timestamps": "Require timezone-aware RFC 3339 input; project to UTC with exactly millisecond precision and terminal Z. Reject naive timestamps and precision that cannot be represented exactly at milliseconds.",
    "json_strings": "Escape quotation mark, reverse solidus and control characters only; use lowercase hexadecimal in required \\u00xx escapes and emit other Unicode as UTF-8.",
    "digest": "The literal prefix 'sha256:' followed by lowercase 64-hex SHA-256 over the exact canonical UTF-8 bytes, with no newline."
  },
