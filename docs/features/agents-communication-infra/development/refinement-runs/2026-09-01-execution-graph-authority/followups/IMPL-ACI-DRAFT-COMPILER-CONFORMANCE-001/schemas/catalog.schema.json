{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.compilation-catalog-fixture@1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "semantics", "providers", "models", "profiles", "capabilities", "validators", "credentials"],
  "properties": {
    "schema": {"const": "aci.compilation-catalog-fixture@1"},
    "semantics": {"type": "array", "items": {"$ref": "#/$defs/simple"}},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/simple"}},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "validators": {"type": "array", "items": {"$ref": "#/$defs/simple"}},
    "credentials": {"type": "array", "items": {"$ref": "#/$defs/credential"}}
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["name", "version", "digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "simple": {"type": "object", "additionalProperties": false, "required": ["key", "ref", "digest_source"], "properties": {"key": {"$ref": "#/$defs/key"}, "ref": {"$ref": "#/$defs/ref"}, "digest_source": {"type": "string", "minLength": 1}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["key", "provider_key", "ref", "digest_source"], "properties": {"key": {"$ref": "#/$defs/key"}, "provider_key": {"$ref": "#/$defs/key"}, "ref": {"$ref": "#/$defs/ref"}, "digest_source": {"type": "string", "minLength": 1}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["key", "provider_key", "model_key", "ref", "digest_source"], "properties": {"key": {"$ref": "#/$defs/key"}, "provider_key": {"$ref": "#/$defs/key"}, "model_key": {"$ref": "#/$defs/key"}, "ref": {"$ref": "#/$defs/ref"}, "digest_source": {"type": "string", "minLength": 1}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["key", "operations", "tool_ref", "digest_source"], "properties": {"key": {"$ref": "#/$defs/key"}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "tool_ref": {"$ref": "#/$defs/ref"}, "digest_source": {"type": "string", "minLength": 1}}},
    "credentialRef": {"type": "object", "additionalProperties": false, "required": ["handle", "resolver_ref", "contract_version", "scope_digest"], "properties": {"handle": {"type": "string", "minLength": 1}, "resolver_ref": {"$ref": "#/$defs/ref"}, "contract_version": {"type": "string", "minLength": 1}, "scope_digest": {"$ref": "#/$defs/digest"}}},
    "credential": {"type": "object", "additionalProperties": false, "required": ["key", "credential_ref", "digest_source"], "properties": {"key": {"$ref": "#/$defs/key"}, "credential_ref": {"$ref": "#/$defs/credentialRef"}, "digest_source": {"type": "string", "minLength": 1}}}
  }
}
