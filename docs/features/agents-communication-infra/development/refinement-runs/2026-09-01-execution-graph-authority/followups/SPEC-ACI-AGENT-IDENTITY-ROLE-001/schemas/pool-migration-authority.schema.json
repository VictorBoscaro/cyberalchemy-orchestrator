{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.pool-migration-authority@1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_path", "source_fixture_path", "source_version", "target_version", "canonical_name_key", "source_raw_digest", "source_metadata_digest", "source_entry_count", "metadata_changes"],
  "properties": {
    "schema": {"const": "aci.pool-migration-authority@1"},
    "source_path": {"const": "telemetry/agents/agent-pool.yaml"},
    "source_fixture_path": {"const": "fixtures/agent-pool.v0.6.yaml"},
    "source_version": {"const": "0.6.0"},
    "target_version": {"const": "0.7.0"},
    "canonical_name_key": {"const": "agent_name"},
    "source_raw_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_metadata_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_entry_count": {"type": "integer", "minimum": 1},
    "metadata_changes": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "last_updated", "prepend_note"],
      "properties": {
        "version": {"const": "0.7.0"},
        "last_updated": {"const": "2026-09-01"},
        "prepend_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
