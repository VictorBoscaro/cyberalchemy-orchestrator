{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.compilation-context@1.proposed.identity-role-r1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dispatch_id", "revision", "allocation_id", "allocation_status", "prior_accepted_graph_digest", "role_registry_ref", "agent_pool_ref", "agent_assignments"],
  "properties": {
    "schema": {"const": "aci.compilation-context-fixture@1"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "allocation_id": {"type": "string", "minLength": 1},
    "allocation_status": {"const": "reserved"},
    "prior_accepted_graph_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "role_registry_ref": {"$ref": "#/$defs/ref"},
    "agent_pool_ref": {"$ref": "#/$defs/ref"},
    "agent_assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["node_key", "display_name", "role_fit_override", "role_fit_override_reason"],
      "properties": {
        "node_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "display_name": {"type": "string", "minLength": 1},
        "role_fit_override": {"type": "boolean"},
        "role_fit_override_reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    }
  }
}
