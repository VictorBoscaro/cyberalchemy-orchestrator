{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.allocator-evidence-fixture@2.identity-role-r2.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_id", "key_id", "context_digest", "is_latest", "pair_is_unbound", "signature"],
  "properties": {
    "schema": {"const": "aci.allocator-evidence-fixture@2"},
    "evidence_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "is_latest": {"type": "boolean"},
    "pair_is_unbound": {"type": "boolean"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
