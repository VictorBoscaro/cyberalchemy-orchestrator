{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.role-registry-envelope@1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "roles"],
  "properties": {
    "schema": {"const": "aci.role-registry@1"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "enabled", "purpose"],
        "properties": {
          "role_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "enabled": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
