{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aci.dispatch-ledger-row@0.7.0",
  "oneOf": [
    {"$ref": "#/$defs/opening"},
    {"$ref": "#/$defs/close"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_id", "schema_version", "agent_role_registry_ref", "dispatch_type", "goal", "context", "max_loops", "anti_bias_mode", "final_approver", "groups"],
      "properties": {
        "dispatch_id": {"type": "string", "minLength": 1},
        "schema_version": {"const": "0.7.0"},
        "agent_role_registry_ref": {"$ref": "#/$defs/registry_ref"},
        "dispatch_type": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "max_loops": {"type": "integer", "minimum": 1, "maximum": 5},
        "anti_bias_mode": {"enum": ["enabled", "disabled"]},
        "final_approver": {"type": "string", "minLength": 1},
        "groups": {"type": "array", "minItems": 1},
        "meta": {"type": "object"},
        "parent_dispatch_id": {"type": "string", "minLength": 1},
        "anti_bias_global": {"type": "string", "minLength": 1},
        "working_folder": {"type": "string", "minLength": 1},
        "output_mode": {"enum": ["inline", "persisted"]},
        "code_contract": {"type": "object"},
        "capability_route": {"type": "object"},
        "invoked_by": {"type": "string", "minLength": 1},
        "connections": {"type": "array"},
        "project_dir": {"type": "string", "minLength": 1}
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["close_of", "schema_version", "agent_role_registry_ref", "exit_reason", "agents_spawned"],
      "properties": {
        "close_of": {"type": "string", "minLength": 1},
        "schema_version": {"const": "0.7.0"},
        "agent_role_registry_ref": {"$ref": "#/$defs/registry_ref"},
        "exit_reason": {"enum": ["resolved", "loop_ceiling_reached", "dissent_irreconcilable", "user_abort", "error"]},
        "agents_spawned": {"type": "object"},
        "feedback_prompts": {"type": "array"},
        "invoked_by": {"type": "string", "minLength": 1},
        "capability_route_digest": {"$ref": "#/$defs/digest"},
        "project_dir": {"type": "string", "minLength": 1}
      }
    }
  }
}
